{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./src/dashboard/client/*"] }
  },
  "include": ["src", "test"],
  "exclude": ["src/dashboard/client"]
}
