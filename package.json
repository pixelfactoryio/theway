{
  "name": "@pixelfactoryio/theway",
  "version": "0.17.0",
  "description": "A spec-first workflow for Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelfactoryio/theway.git"
  },
  "type": "module",
  "bin": {
    "theway": "dist/theway.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "plugin"
  ],
  "scripts": {
    "build": "bun scripts/embed-fonts.ts && tailwindcss -i src/dashboard/client/styles/globals.css -o src/dashboard/generated/app.css.txt --minify && bun build src/dashboard/client/main.tsx --target=browser --minify --define 'process.env.NODE_ENV=\"production\"' --outfile src/dashboard/generated/client.txt && bun build src/cli.ts --target=node --outfile dist/theway.js",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/dashboard/client",
    "test": "bun test",
    "lint:md": "git ls-files -z '*.md' ':!:CHANGELOG.md' | xargs -0 markdownlint-cli2"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@clack/prompts": "1.8.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@tailwindcss/cli": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "hono": "4.13.13",
    "lucide-react": "1.61.0",
    "markdownlint-cli2": "0.24.0",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5",
    "wouter": "3.13.0",
    "yaml": "2.9.1"
  }
}
