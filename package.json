{
  "name": "@pixelfactoryio/theway",
  "version": "0.20.0",
  "description": "A spec-first workflow for Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelfactoryio/theway.git"
  },
  "type": "module",
  "bin": {
    "theway": "dist/theway.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "plugin"
  ],
  "scripts": {
    "build": "bun scripts/embed-fonts.ts && tailwindcss -i src/dashboard/client/styles/globals.css -o src/dashboard/generated/app.css.txt --minify && bun build src/dashboard/client/main.tsx --target=browser --production --outfile src/dashboard/generated/app.js.txt --metafile=src/dashboard/generated/app.meta.json && bun build src/cli.ts --target=node --outfile dist/theway.js --metafile=src/dashboard/generated/cli.meta.json && bun scripts/third-party-notices.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/dashboard/client",
    "test": "bun test",
    "lint:md": "git ls-files -z '*.md' ':!:CHANGELOG.md' | xargs -0 markdownlint-cli2"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@clack/prompts": "1.8.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hono/node-server": "2.1.8",
    "@lezer/highlight": "1.2.5",
    "@panzoom/panzoom": "4.6.2",
    "@tailwindcss/cli": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "hono": "4.13.18",
    "lucide-react": "1.72.0",
    "markdownlint-cli2": "0.24.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.21.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "^5",
    "wouter": "3.13.0",
    "yaml": "2.9.1"
  }
}
