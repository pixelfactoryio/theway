{
  "name": "@pixelfactoryio/theway",
  "version": "0.23.1",
  "description": "A spec-first workflow for Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelfactoryio/theway.git"
  },
  "type": "module",
  "bin": {
    "theway": "dist/theway.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "plugin"
  ],
  "scripts": {
    "build": "bun scripts/embed-fonts.ts && tailwindcss -i src/dashboard/client/styles/globals.css -o src/dashboard/generated/app.css.txt --minify && bun build src/dashboard/client/main.tsx --target=browser --production --outfile src/dashboard/generated/app.js.txt --metafile=src/dashboard/generated/app.meta.json && bun build src/cli.ts --target=node --outfile dist/theway.js --metafile=src/dashboard/generated/cli.meta.json && bun scripts/third-party-notices.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/dashboard/client",
    "test": "bun run build && bun test",
    "lint:md": "git ls-files -z '*.md' ':!:CHANGELOG.md' | xargs -0 markdownlint-cli2",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write \"**/*.{ts,tsx,js}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js}\""
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@clack/prompts": "1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.8",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hono/node-server": "2.1.8",
    "@lezer/highlight": "1.2.5",
    "@tailwindcss/cli": "4.3.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "commander": "15.1.0",
    "date-fns": "4.4.0",
    "diff": "9.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "hono": "4.13.18",
    "lucide-react": "1.73.0",
    "markdownlint-cli2": "0.24.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.24.0",
    "regexparam": "3.0.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "^5",
    "typescript-eslint": "8.72.2",
    "wouter": "3.13.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
