{
  "name": "@pixelfactoryio/theway",
  "version": "0.17.0",
  "description": "A spec-first workflow for Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelfactoryio/theway.git"
  },
  "type": "module",
  "bin": {
    "theway": "dist/theway.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "plugin"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile dist/theway.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "lint:md": "git ls-files -z '*.md' ':!:CHANGELOG.md' | xargs -0 markdownlint-cli2"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@types/node": "^22",
    "commander": "15.0.0",
    "markdownlint-cli2": "0.24.0",
    "typescript": "^5",
    "yaml": "2.9.1"
  }
}
