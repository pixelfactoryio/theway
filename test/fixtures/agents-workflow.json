{
  "name": "agents",
  "file": "<home>/workflows/agents.yaml",
  "input": "changes",
  "commits": "<home>/standards/commits.md",
  "git_host": "<home>/standards/git-host.md",
  "pushes": true,
  "working_tree": false,
  "steps": [
    {
      "id": "implement",
      "step": "implement",
      "agents": true,
      "file": "<home>/steps/implement.yaml",
      "description": "Implement the change's tasks as its spec says",
      "params": {
        "model": {
          "value": "opus",
          "from": "steps/implement.yaml"
        }
      },
      "do": [
        {
          "agent": {
            "name": "implement",
            "label": "implement:implement",
            "prompt": [
              "<home>/prompts/implement.md"
            ],
            "returns": "work",
            "access": "commit",
            "model": "opus"
          }
        }
      ]
    },
    {
      "id": "review",
      "step": "review",
      "agents": true,
      "file": "<home>/steps/review.yaml",
      "description": "Review the diff through each lens, triage the findings, fix the confirmed ones and check the fixes",
      "params": {
        "rounds": {
          "value": 1,
          "from": "steps/review.yaml"
        },
        "lenses": {
          "value": [
            "conformance",
            "correctness"
          ],
          "from": "steps/review.yaml"
        },
        "model": {
          "value": "opus",
          "from": "steps/review.yaml"
        },
        "fix_model": {
          "value": "opus",
          "from": "steps/review.yaml"
        }
      },
      "do": [
        {
          "loop": {
            "max": 1,
            "until": [
              "no-confirmed"
            ],
            "exhausted": "continue",
            "do": [
              {
                "parallel": [
                  {
                    "agent": {
                      "name": "conformance",
                      "label": "review:conformance",
                      "prompt": [
                        "<home>/prompts/reviewer.md",
                        "<home>/prompts/conformance.md"
                      ],
                      "returns": "findings",
                      "access": "read",
                      "model": "opus"
                    }
                  },
                  {
                    "agent": {
                      "name": "correctness",
                      "label": "review:correctness",
                      "prompt": [
                        "<home>/prompts/reviewer.md",
                        "<home>/prompts/correctness.md"
                      ],
                      "returns": "findings",
                      "access": "read",
                      "model": "opus"
                    }
                  }
                ]
              },
              {
                "when": [
                  "findings"
                ],
                "do": [
                  {
                    "agent": {
                      "name": "triage",
                      "label": "review:triage",
                      "prompt": [
                        "<home>/prompts/verdicts.md",
                        "<home>/prompts/triage.md"
                      ],
                      "returns": "verdicts",
                      "access": "read",
                      "model": "opus"
                    }
                  }
                ]
              },
              {
                "when": [
                  "confirmed"
                ],
                "do": [
                  {
                    "agent": {
                      "name": "fix",
                      "label": "review:fix",
                      "prompt": [
                        "<home>/prompts/fix.md"
                      ],
                      "returns": "work",
                      "access": "commit",
                      "model": "opus"
                    }
                  },
                  {
                    "agent": {
                      "name": "fix-check",
                      "label": "review:fix-check",
                      "prompt": [
                        "<home>/prompts/fix-check.md"
                      ],
                      "returns": "resolutions",
                      "access": "read",
                      "model": "opus"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "pr",
      "step": "pr",
      "agents": true,
      "file": "<home>/steps/pr.yaml",
      "description": "Push the branch, open the PR and drive CI to green",
      "params": {
        "ci_attempts": {
          "value": 2,
          "from": "steps/pr.yaml"
        },
        "model": {
          "value": "sonnet",
          "from": "steps/pr.yaml"
        },
        "fix_model": {
          "value": "opus",
          "from": "steps/pr.yaml"
        }
      },
      "do": [
        {
          "agent": {
            "name": "open-pr",
            "label": "pr:open-pr",
            "prompt": [
              "<home>/prompts/open-pr.md"
            ],
            "returns": "pr",
            "access": "push",
            "model": "sonnet"
          }
        },
        {
          "loop": {
            "max": 2,
            "until": [
              "green"
            ],
            "exhausted": "fail",
            "do": [
              {
                "agent": {
                  "name": "ci-wait",
                  "label": "pr:ci-wait",
                  "prompt": [
                    "<home>/prompts/ci-wait.md"
                  ],
                  "returns": "ci",
                  "access": "read",
                  "model": "sonnet"
                }
              },
              {
                "when": [
                  "red"
                ],
                "do": [
                  {
                    "agent": {
                      "name": "ci-diagnose",
                      "label": "pr:ci-diagnose",
                      "prompt": [
                        "<home>/prompts/ci-diagnose.md"
                      ],
                      "returns": "diagnosis",
                      "access": "read",
                      "model": "sonnet"
                    }
                  },
                  {
                    "when": [
                      "fixable",
                      "more"
                    ],
                    "do": [
                      {
                        "agent": {
                          "name": "ci-fix",
                          "label": "pr:ci-fix",
                          "prompt": [
                            "<home>/prompts/ci-fix.md"
                          ],
                          "returns": "work",
                          "access": "push",
                          "model": "opus"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
